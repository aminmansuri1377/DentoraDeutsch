+    ).rejects.toMatchObject({
+      code: "FORBIDDEN",
+      message: "Keine Herzen verfügbar.",
+    });
+    vi.stubEnv("DISABLE_LEARNING_LIMITS", "true");
+    expect(
+      (await submitAnswer(user.id, attempt.id, question.id, wrong.id)).correct,
+    ).toBe(false);
+    expect(
