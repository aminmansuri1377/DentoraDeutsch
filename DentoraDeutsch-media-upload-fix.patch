index 0000000..44059a0
--- /dev/null
+++ b/tests/post-upload-retry.test.tsx
@@ -0,0 +1,71 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from "vitest";
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+const state = vi.hoisted(() => ({
+  upload: vi.fn(),
+  publish: vi.fn(),
+}));
+vi.mock("@/trpc/provider", () => ({
+  useTRPC: () => ({ social: { create: { mutationOptions: () => ({}) } } }),
+}));
+vi.mock("@tanstack/react-query", () => ({
+  useMutation: () => ({ mutate: state.publish, isPending: false, error: null }),
+}));
+vi.mock("@/features/community/use-social-refresh", () => ({
+  useSocialRefresh: () => vi.fn(),
+}));
+vi.mock("@/features/media/use-image-upload", () => ({
+  useImageUpload: () => ({
+    mutateAsync: state.upload,
+    isPending: false,
+    isError: true,
+    error: new Error("Upload fehlgeschlagen"),
+    reset: vi.fn(),
+  }),
+}));
+import { PostComposer } from "../src/features/community/components/post-composer";
+afterEach(() => {
+  cleanup();
+  vi.resetAllMocks();
+});
+it("keeps text and the file after failure, blocks publication, and retries that file", async () => {
+  state.upload
+    .mockRejectedValueOnce(new Error("fetch failed"))
+    .mockResolvedValueOnce({ id: "image-id", url: "/api/media/image-id" });
+  const { container } = render(
+    <PostComposer onClose={vi.fn()} onPublished={vi.fn()} />,
+  );
+  fireEvent.change(screen.getByLabelText("Dein Beitrag"), {
+    target: { value: "Mein Beitrag" },
+  });
+  const file = new File(["image"], "post.webp", { type: "image/webp" });
+  fireEvent.change(container.querySelector('input[type="file"]')!, {
+    target: { files: [file] },
+  });
+  await waitFor(() => expect(state.upload).toHaveBeenCalledOnce());
+  const publish = screen.getByRole("button", {
+    name: "Veröffentlichen",
+  }) as HTMLButtonElement;
+  expect(publish.disabled).toBe(true);
+  fireEvent.submit(container.querySelector("form")!);
+  expect(state.publish).not.toHaveBeenCalled();
+  fireEvent.click(
+    await screen.findByRole("button", { name: "Bildupload erneut versuchen" }),
+  );
+  await waitFor(() => expect(publish.disabled).toBe(false));
+  expect(state.upload.mock.calls[1][0]).toBe(file);
+  expect(
+    (screen.getByLabelText("Dein Beitrag") as HTMLTextAreaElement).value,
+  ).toBe("Mein Beitrag");
+  fireEvent.submit(container.querySelector("form")!);
+  expect(state.publish).toHaveBeenCalledWith({
+    body: "Mein Beitrag",
+    mediaId: "image-id",
+  });
+});
diff --git a/tests/storage-upload.test.ts b/tests/storage-upload.test.ts
new file mode 100644
index 0000000..b979f7f
--- /dev/null
+++ b/tests/storage-upload.test.ts
@@ -0,0 +1,74 @@
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { uploadObject } from "../src/server/media/storage";
+const fetchMock = vi.fn();
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.stubGlobal("fetch", fetchMock);
+  fetchMock.mockReset();
+  vi.stubEnv("SUPABASE_URL", "https://project.supabase.co");
+  vi.stubEnv("SUPABASE_SERVICE_ROLE_KEY", "secret-not-for-logs");
+  vi.spyOn(console, "warn").mockImplementation(() => {});
+});
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+});
+it("recovers from a lost response with the exact same key and bytes", async () => {
+  fetchMock
+    .mockRejectedValueOnce(new TypeError("fetch failed"))
+    .mockResolvedValueOnce(new Response("{}", { status: 200 }));
+  const bytes = Buffer.from("image");
+  const result = uploadObject("user/random.webp", bytes);
+  await vi.runAllTimersAsync();
+  await result;
+  expect(fetchMock).toHaveBeenCalledTimes(2);
+  const [first, second] = fetchMock.mock.calls;
+  expect(first[0]).toBe(second[0]);
+  expect(first[1].body).toEqual(second[1].body);
+  expect(second[1].headers["x-upsert"]).toBe("true");
+});
+it("retries temporary HTTP failures but stops after three attempts", async () => {
+  fetchMock.mockImplementation(async () => new Response("", { status: 503 }));
+  const result = expect(
+    uploadObject("user/random.webp", Buffer.from("x")),
+  ).rejects.toThrow("ausgelastet");
+  await vi.runAllTimersAsync();
+  await result;
+  expect(fetchMock).toHaveBeenCalledTimes(3);
+});
+it("does not retry invalid credentials or bucket permissions", async () => {
+  fetchMock.mockResolvedValueOnce(new Response("", { status: 403 }));
+  await expect(
+    uploadObject("user/random.webp", Buffer.from("x")),
+  ).rejects.toThrow("abgelehnt");
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+});
+it("reports exhausted network failures without exposing credentials", async () => {
+  fetchMock.mockRejectedValue(
+    new TypeError("secret-not-for-logs", {
+      cause: { code: "ECONNRESET" },
+    }),
+  );
+  const result = expect(
+    uploadObject("user/random.webp", Buffer.from("x")),
+  ).rejects.toThrow("momentan nicht erreichbar");
+  await vi.runAllTimersAsync();
+  await result;
+  expect(fetchMock).toHaveBeenCalledTimes(3);
+  expect(JSON.stringify(vi.mocked(console.warn).mock.calls)).not.toContain(
+    "secret-not-for-logs",
+  );
+});
+it("does not retry certificate errors or weaken TLS", async () => {
+  fetchMock.mockRejectedValue(
+    new TypeError("fetch failed", {
+      cause: { code: "SELF_SIGNED_CERT_IN_CHAIN" },
+    }),
+  );
+  await expect(
+    uploadObject("user/random.webp", Buffer.from("x")),
+  ).rejects.toThrow("sichere Verbindung");
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+});
