--- /dev/null
+++ b/src/features/community/components/follow-button.tsx
@@ -0,0 +1,37 @@
+"use client";
+import { useMutation } from "@tanstack/react-query";
+import { useTRPC } from "@/trpc/provider";
+import { useSocialRefresh } from "../use-social-refresh";
+import styles from "../community.module.css";
+export function FollowButton({
+  userId,
+  following,
+  isSelf = false,
+}: {
+  userId: string;
+  following: boolean;
+  isSelf?: boolean;
+}) {
+  const api = useTRPC(),
+    refresh = useSocialRefresh();
+  const mutation = useMutation(
+    api.social.follow.mutationOptions({
+      onSuccess: async () => {
+        await refresh();
+      },
+    }),
+  );
+  if (isSelf) return null;
+  return (
+    <div className={styles.follow}>
+      <button
+        disabled={mutation.isPending}
+        aria-pressed={following}
+        onClick={() => mutation.mutate({ userId, follow: !following })}
+      >
+        {mutation.isPending ? "…" : following ? "Entfolgen" : "+ Folgen"}
+      </button>
+      {mutation.error && <small role="alert">{mutation.error.message}</small>}
+    </div>
+  );
+}
diff --git a/src/features/community/components/post-card.tsx b/src/features/community/components/post-card.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..11686e811af7f01c9f5fb717b7f9c972125fb1b3
--- /dev/null
+++ b/src/features/community/components/post-card.tsx
@@ -0,0 +1,147 @@
+"use client";
+import Link from "next/link";
+import { useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import type { inferRouterOutputs } from "@trpc/server";
+import type { AppRouter } from "@/server/routers";
+import { Heart, Bookmark, MessageCircle, Trash2 } from "lucide-react";
+import { Avatar } from "@/components/ui/avatar";
+import { useTRPC } from "@/trpc/provider";
+import { Comments } from "../comments";
+import { FollowButton } from "./follow-button";
+import { profileHref } from "../profile-link";
+import { useSocialRefresh } from "../use-social-refresh";
+import styles from "../community.module.css";
+export type FeedPost =
+  inferRouterOutputs<AppRouter>["social"]["feed"]["items"][number];
+export function PostCard({
+  post,
+  viewerId,
+}: {
+  post: FeedPost;
+  viewerId: string;
+}) {
+  const [expanded, setExpanded] = useState(false),
+    [comments, setComments] = useState(false),
+    [confirmDelete, setConfirmDelete] = useState(false);
+  const api = useTRPC(),
+    refresh = useSocialRefresh();
+  const options = {
+    onSuccess: async () => {
+      await refresh();
+    },
+  };
+  const like = useMutation(api.social.like.mutationOptions(options)),
+    save = useMutation(api.social.save.mutationOptions(options)),
+    remove = useMutation(api.social.remove.mutationOptions(options));
+  const liked = !!post.likes.length,
+    saved = !!post.bookmarks.length,
+    error = like.error || save.error || remove.error;
+  return (
+    <article className={styles.post}>
+      <header className={styles.author}>
+        <Link className={styles.authorIdentity} href={profileHref(post.author)}>
+          <Avatar image={post.author.image} name={post.author.name} />
+          <span>
+            <strong>{post.author.name || "Dentora Mitglied"}</strong>
+            <small>{post.author.university || "Dentora Community"}</small>
+            <time dateTime={post.createdAt.toISOString()}>
+              {post.createdAt.toLocaleDateString("de-DE", {
+                day: "numeric",
+                month: "short",
+              })}
+            </time>
+          </span>
+        </Link>
+        <FollowButton
+          userId={post.authorId}
+          following={!!post.author.follow_following.length}
+          isSelf={viewerId === post.authorId}
+        />
+      </header>
+      {post.body && (
+        <div className={styles.body}>
+          <p>
+            {expanded || post.body.length <= 350
+              ? post.body
+              : post.body.slice(0, 350) + " …"}
+          </p>
+          {post.body.length > 350 && (
+            <button
+              onClick={() => setExpanded(!expanded)}
+              aria-expanded={expanded}
+            >
+              {expanded ? "Weniger anzeigen" : "Mehr anzeigen"}
+            </button>
+          )}
+        </div>
+      )}
+      {post.media_post.map((media) => (
+        <img
+          key={media.id}
+          className={styles.postImage}
+          src={`/api/media/${media.id}`}
+          alt="Bild zum Beitrag"
+          loading="lazy"
+        />
+      ))}
+      <div className={styles.actions}>
+        <button
+          aria-label={
+            saved ? "Beitrag nicht mehr speichern" : "Beitrag speichern"
+          }
+          aria-pressed={saved}
+          disabled={save.isPending}
+          onClick={() => save.mutate({ postId: post.id, saved: !saved })}
+        >
+          <Bookmark size={20} fill={saved ? "currentColor" : "none"} />
+        </button>
+        <div>
+          <button
+            aria-label={`${post._count.comments} Kommentare anzeigen`}
+            aria-expanded={comments}
+            onClick={() => setComments(!comments)}
+          >
+            <MessageCircle size={20} />
+            {post._count.comments}
+          </button>
+          <button
+            aria-label={liked ? "Gefällt mir zurücknehmen" : "Gefällt mir"}
+            aria-pressed={liked}
+            disabled={like.isPending}
+            onClick={() => like.mutate({ postId: post.id, liked: !liked })}
+          >
+            <Heart size={20} fill={liked ? "currentColor" : "none"} />
+            {post._count.likes}
+          </button>
+        </div>
+        {viewerId === post.authorId && (
+          <button
+            aria-label="Beitrag löschen"
+            onClick={() => setConfirmDelete(!confirmDelete)}
+          >
+            <Trash2 size={17} />
+          </button>
+        )}
+      </div>
+      {confirmDelete && (
+        <div className={styles.deleteConfirm}>
+          <p>Diesen Beitrag entfernen?</p>
+          <button
+            disabled={remove.isPending}
+            onClick={() => remove.mutate({ id: post.id })}
+          >
+            Entfernen
+          </button>
+          <button onClick={() => setConfirmDelete(false)}>Abbrechen</button>
+        </div>
+      )}
+      {error && (
+        <p className={styles.error} role="alert">
+          {error.message}
+        </p>
+      )}
+      {comments && <Comments postId={post.id} />}
+    </article>
+  );
+}
diff --git a/src/features/community/components/post-composer.tsx b/src/features/community/components/post-composer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b9728e71f2880be1fcb2fbd6d2914d356ef05666
--- /dev/null
+++ b/src/features/community/components/post-composer.tsx
@@ -0,0 +1,105 @@
+"use client";
+import { useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import { ImagePlus, Send, X } from "lucide-react";
+import { useTRPC } from "@/trpc/provider";
+import { useImageUpload } from "@/features/media/use-image-upload";
+import { useSocialRefresh } from "../use-social-refresh";
+import styles from "../community.module.css";
+export function PostComposer({
+  onClose,
+  onPublished,
+}: {
+  onClose: () => void;
+  onPublished: () => void;
+}) {
+  const [body, setBody] = useState(""),
+    [media, setMedia] = useState<{ id: string; url: string } | null>(null);
+  const api = useTRPC(),
+    refresh = useSocialRefresh(),
+    upload = useImageUpload("post");
+  const create = useMutation(
+    api.social.create.mutationOptions({
+      onSuccess: async () => {
+        setBody("");
+        setMedia(null);
+        await refresh();
+        onPublished();
+      },
+    }),
+  );
+  const busy = create.isPending || upload.isPending;
+  return (
+    <section className={styles.composer} aria-label="Neuen Beitrag erstellen">
+      <div className={styles.editorHeading}>
+        <h2>Was möchtest du teilen?</h2>
+        <button aria-label="Editor schließen" disabled={busy} onClick={onClose}>
+          <X size={20} />
+        </button>
+      </div>
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          create.mutate({ body, mediaId: media?.id });
+        }}
+      >
+        <label htmlFor="post-body">Dein Beitrag</label>
+        <textarea
+          autoFocus
+          id="post-body"
+          value={body}
+          onChange={(e) => setBody(e.target.value)}
+          maxLength={5000}
+          rows={5}
+          placeholder="Eine Frage, ein Gedanke oder ein Lernerfolg …"
+        />
+        {media && (
+          <div className={styles.imagePreview}>
+            <img src={media.url} alt="Vorschau des Beitragsbildes" />
+            <button
+              type="button"
+              disabled={busy}
+              onClick={() => setMedia(null)}
+              aria-label="Bild entfernen"
+            >
+              <X size={18} />
+            </button>
+          </div>
+        )}
+        <div className={styles.editorActions}>
+          <label className={styles.attach}>
+            <ImagePlus size={20} />
+            {upload.isPending ? "Bild wird hochgeladen …" : "Bild hinzufügen"}
+            <input
+              type="file"
+              accept="image/jpeg,image/png,image/webp"
+              disabled={busy}
+              onChange={async (e) => {
+                const file = e.target.files?.[0];
+                e.target.value = "";
+                if (file) {
+                  try {
+                    setMedia(await upload.mutateAsync(file));
+                  } catch {}
+                }
+              }}
+            />
+          </label>
+          <button
+            className="button primary"
+            disabled={busy || (!body.trim() && !media)}
+          >
+            <Send size={16} />
+            {create.isPending ? "Wird veröffentlicht …" : "Veröffentlichen"}
+          </button>
+        </div>
+        <small>JPG, PNG oder WebP · max. 2 MB · {body.length}/5000</small>
+        {(upload.error || create.error) && (
+          <p role="alert" className={styles.error}>
+            {upload.error?.message || create.error?.message}
+          </p>
+        )}
+      </form>
+    </section>
+  );
+}
diff --git a/src/features/community/components/post-feed.tsx b/src/features/community/components/post-feed.tsx
new file mode 100644
