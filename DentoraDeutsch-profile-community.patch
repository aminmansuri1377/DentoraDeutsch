diff --git a/scripts/setup-storage.ts b/scripts/setup-storage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..af2a3ad68bb747a4f20af4804f04cfeaa6d2ba4f
--- /dev/null
+++ b/scripts/setup-storage.ts
@@ -0,0 +1,63 @@
+import "./load-env";
+const raw = process.env.SUPABASE_URL,
+  key = process.env.SUPABASE_SERVICE_ROLE_KEY,
+  bucket = process.env.SUPABASE_MEDIA_BUCKET || "dentora-media";
+try {
+  if (!raw || !key)
+    throw new Error("SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY fehlen.");
+  const url = new URL(raw);
+  if (
+    url.protocol !== "https:" ||
+    url.username ||
+    url.password ||
+    !/^[a-z0-9-]+$/.test(bucket)
+  )
+    throw new Error("Ungültige Storage-Konfiguration.");
+  const base = `${url.origin}/storage/v1/bucket`,
+    headers = {
+      apikey: key,
+      Authorization: `Bearer ${key}`,
+      "Content-Type": "application/json",
+    };
+  const existing = await fetch(`${base}/${bucket}`, {
+    headers,
+    signal: AbortSignal.timeout(15000),
+  });
+  if (existing.ok) {
+    const data = await existing.json();
+    if (data.public)
+      throw new Error(
+        "Der vorhandene Bucket ist öffentlich. Bitte stelle ihn in Supabase auf Private.",
+      );
+    console.log("STORAGE_OK: Privater Bucket vorhanden.");
+  } else {
+    // Supabase can return 400 or 404 for an absent bucket; distinguish auth errors.
+    const detail = await existing.json().catch(() => ({}));
+    if (!["404", 404].includes(detail.statusCode) && existing.status !== 404)
+      throw new Error(
+        "Bucket konnte nicht geprüft werden. Prüfe URL und service_role-Schlüssel.",
+      );
+    const created = await fetch(base, {
+      method: "POST",
+      headers,
+      body: JSON.stringify({
+        id: bucket,
+        name: bucket,
+        public: false,
+        file_size_limit: 2097152,
+        allowed_mime_types: ["image/webp"],
+      }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!created.ok)
+      throw new Error(
+        "Bucket konnte nicht erstellt werden. Prüfe die Storage-Konfiguration.",
+      );
+    console.log("STORAGE_OK: Privater Bucket dentora-media eingerichtet.");
+  }
+} catch (e) {
+  console.error(
+    e instanceof Error ? e.message : "Storage-Einrichtung fehlgeschlagen.",
+  );
+  process.exitCode = 1;
+}
diff --git a/src/app/api/media/[id]/route.ts b/src/app/api/media/[id]/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ecba5ddbf7138b4ae2b88987e9b0f8878ef917c0
--- /dev/null
+++ b/src/app/api/media/[id]/route.ts
@@ -0,0 +1,40 @@
+import { auth } from "@/server/auth";
+import { db } from "@/server/db";
+import { downloadObject } from "@/server/media/storage";
+export const runtime = "nodejs";
+export async function GET(
+  _request: Request,
+  { params }: { params: Promise<{ id: string }> },
+) {
+  const viewer = (await auth())?.user?.id;
+  if (!viewer) return new Response(null, { status: 401 });
+  const { id } = await params;
+  const media = await db.media.findUnique({
+    where: { id },
+    include: {
+      post: { select: { deletedAt: true } },
+      owner: { select: { image: true } },
+    },
+  });
+  // Unattached post images and replaced avatars are visible only to their owner.
+  const visible =
+    media &&
+    (media.ownerId === viewer ||
+      (media.status === "AVATAR" && media.owner.image === `/api/media/${id}`) ||
+      (media.status === "READY" && media.post && !media.post.deletedAt));
+  if (!visible) return new Response(null, { status: 404 });
+  try {
+    const response = await downloadObject(media.objectKey);
+    if (!response.ok) return new Response(null, { status: 404 });
+    return new Response(response.body, {
+      headers: {
+        "Content-Type": "image/webp",
+        "Cache-Control": "private, no-store",
+        "X-Content-Type-Options": "nosniff",
+        "Content-Disposition": "inline",
+      },
+    });
+  } catch {
+    return new Response(null, { status: 503 });
+  }
+}
diff --git a/src/app/api/media/route.ts b/src/app/api/media/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02c0de1824201a19af17ae7425d97885d5708578
--- /dev/null
+++ b/src/app/api/media/route.ts
@@ -0,0 +1,94 @@
+import { randomUUID } from "node:crypto";
+import { auth } from "@/server/auth";
+import { db } from "@/server/db";
+import { limit } from "@/server/rate-limit";
+import { isTrustedMutation } from "@/server/security/request-origin";
+import { MAX_UPLOAD_BYTES, prepareImage } from "@/server/media/image";
+import { uploadObject, deleteObject } from "@/server/media/storage";
+export const runtime = "nodejs";
+export const maxDuration = 30;
+const error = (message: string, status: number) =>
+  Response.json({ message }, { status });
+export async function POST(request: Request) {
+  if (!isTrustedMutation(request)) return error("Anfrage nicht erlaubt.", 403);
+  const session = await auth();
+  const userId = session?.user?.id;
+  if (!userId) return error("Bitte melde dich an.", 401);
+  if (!(await limit(`image:${userId}`, 12, 3600)))
+    return error("Zu viele Uploads. Bitte versuche es später erneut.", 429);
+  // Bound the stream itself, not just Content-Length (which may be omitted/forged).
+  const reader = request.body?.getReader();
+  if (!reader) return error("Bild fehlt.", 400);
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  while (true) {
+    const part = await reader.read();
+    if (part.done) break;
+    length += part.value.length;
+    if (length > MAX_UPLOAD_BYTES + 65536) {
+      await reader.cancel();
+      return error("Maximal 2 MB pro Bild.", 413);
+    }
+    chunks.push(part.value);
+  }
+  let form: FormData;
+  try {
+    form = await new Response(Buffer.concat(chunks), {
+      headers: { "Content-Type": request.headers.get("content-type") ?? "" },
+    }).formData();
+  } catch {
+    return error("Ungültiger Upload.", 400);
+  }
+  const file = form.get("file"),
+    purpose = form.get("purpose");
+  if (!(file instanceof File) || !["avatar", "post"].includes(String(purpose)))
+    return error("Bitte wähle ein gültiges Bild.", 400);
+  let bytes: Buffer;
+  try {
+    bytes = await prepareImage(
+      Buffer.from(await file.arrayBuffer()),
+      purpose as "avatar" | "post",
+    );
+  } catch {
+    return error(
+      "Bitte wähle ein gültiges JPG-, PNG- oder WebP-Bild (maximal 2 MB, 16 Megapixel).",
+      400,
+    );
+  }
+  const id = randomUUID(),
+    objectKey = `${encodeURIComponent(userId)}/${id}.webp`;
+  try {
+    await uploadObject(objectKey, bytes);
+  } catch (e) {
+    return error(
+      e instanceof Error ? e.message : "Upload fehlgeschlagen.",
+      503,
+    );
+  }
+  try {
+    await db.$transaction(async (tx) => {
+      await tx.media.create({
+        data: {
+          id,
+          ownerId: userId,
+          objectKey,
+          mimeType: "image/webp",
+          size: bytes.length,
+          status: purpose === "avatar" ? "AVATAR" : "READY",
+        },
+      });
+      if (purpose === "avatar")
+        await tx.user.update({
+          where: { id: userId },
+          data: { image: `/api/media/${id}` },
+        });
+    });
+    return Response.json({ id, url: `/api/media/${id}` }, { status: 201 });
+  } catch {
+    await deleteObject(objectKey).catch(() => {});
+    return error(
+      "Das Bild konnte nicht zugeordnet werden. Bitte versuche es erneut.",
+      503,
+    );
+  }
+}
