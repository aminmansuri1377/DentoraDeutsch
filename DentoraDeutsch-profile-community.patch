diff --git a/tests/image-upload.test.ts b/tests/image-upload.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f9dbd7f828c7a797ff4e47476c6bc087cdfc3803
--- /dev/null
+++ b/tests/image-upload.test.ts
@@ -0,0 +1,33 @@
+import { it, expect } from "vitest";
+import sharp from "sharp";
+import { prepareImage, MAX_UPLOAD_BYTES } from "../src/server/media/image";
+it("decodes and re-encodes avatars with bounded dimensions and no metadata", async () => {
+  const source = await sharp({
+    create: { width: 800, height: 600, channels: 3, background: "#9955bb" },
+  })
+    .jpeg()
+    .withMetadata()
+    .toBuffer();
+  const image = await prepareImage(source, "avatar"),
+    meta = await sharp(image).metadata();
+  expect(meta.format).toBe("webp");
+  expect(meta.width).toBe(384);
+  expect(meta.height).toBe(384);
+  expect(meta.exif).toBeUndefined();
+});
+it("rejects disguised files, SVG and oversized images", async () => {
+  await expect(
+    prepareImage(Buffer.from("not an image"), "post"),
+  ).rejects.toThrow();
+  await expect(
+    prepareImage(
+      Buffer.from(
+        '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"></svg>',
+      ),
+      "post",
+    ),
+  ).rejects.toThrow();
+  await expect(
+    prepareImage(Buffer.alloc(MAX_UPLOAD_BYTES + 1), "avatar"),
+  ).rejects.toThrow();
+});
diff --git a/tests/media-routes.test.ts b/tests/media-routes.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b4447bfdf6dac4a00c0c2b6d52d98ecc014c8671
--- /dev/null
+++ b/tests/media-routes.test.ts
@@ -0,0 +1,110 @@
+import { beforeEach, it, expect, vi } from "vitest";
+import sharp from "sharp";
+const state = vi.hoisted(() => ({
+  viewer: "owner" as string | undefined,
+  media: null as any,
+  create: vi.fn(),
+  update: vi.fn(),
+}));
+vi.mock("@/server/auth", () => ({
+  auth: async () => (state.viewer ? { user: { id: state.viewer } } : null),
+}));
+vi.mock("@/server/db", () => ({
+  db: {
+    $transaction: async (fn: any) =>
+      fn({ media: { create: state.create }, user: { update: state.update } }),
+    media: { findUnique: async () => state.media },
+  },
+}));
+vi.mock("@/server/rate-limit", () => ({ limit: async () => true }));
+vi.mock("@/server/media/storage", () => ({
+  uploadObject: vi.fn(async () => {}),
+  deleteObject: vi.fn(async () => {}),
+  downloadObject: vi.fn(async () => new Response("image")),
+}));
+import { POST } from "../src/app/api/media/route";
+import { GET } from "../src/app/api/media/[id]/route";
+import {
+  uploadObject,
+  downloadObject,
+  deleteObject,
+} from "../src/server/media/storage";
+beforeEach(() => {
+  vi.clearAllMocks();
+  state.viewer = "owner";
+  state.media = null;
+  state.create.mockResolvedValue({});
+  state.update.mockResolvedValue({});
+  vi.stubEnv("AUTH_URL", "https://dentora.test");
+});
+function request(bytes: Uint8Array, origin = "https://dentora.test") {
+  const form = new FormData();
+  form.append(
+    "file",
+    new File([new Uint8Array(bytes)], "test.jpg", { type: "image/jpeg" }),
+  );
+  form.append("purpose", "avatar");
+  return new Request("https://dentora.test/api/media", {
+    method: "POST",
+    headers: { origin },
+    body: form,
+  });
+}
+it("rejects unauthenticated and cross-origin uploads before touching storage", async () => {
+  expect(
+    (await POST(request(new Uint8Array(), "https://evil.test"))).status,
+  ).toBe(403);
+  state.viewer = undefined;
+  expect((await POST(request(new Uint8Array()))).status).toBe(401);
+  expect(uploadObject).not.toHaveBeenCalled();
+});
+it("saves only sanitized images and updates the authenticated user", async () => {
+  const input = await sharp({
+    create: { width: 32, height: 32, channels: 3, background: "red" },
+  })
+    .jpeg()
+    .toBuffer();
+  const response = await POST(request(input));
+  expect(response.status).toBe(201);
+  const result = await response.json();
+  expect(result.url).toBe("/api/media/" + result.id);
+  expect(state.update).toHaveBeenCalledWith({
+    where: { id: "owner" },
+    data: { image: result.url },
+  });
+  expect(
+    (await sharp(vi.mocked(uploadObject).mock.calls[0][1]).metadata()).format,
+  ).toBe("webp");
+});
+it("rejects files with a forged image extension and cleans storage after DB failure", async () => {
+  expect(
+    (await POST(request(new TextEncoder().encode("not jpeg")))).status,
+  ).toBe(400);
+  const input = await sharp({
+    create: { width: 16, height: 16, channels: 3, background: "red" },
+  })
+    .png()
+    .toBuffer();
+  state.create.mockRejectedValueOnce(new Error("db unavailable"));
+  expect((await POST(request(input))).status).toBe(503);
+  expect(deleteObject).toHaveBeenCalledOnce();
+});
+it("does not serve another user’s unattached image or a deleted post image", async () => {
+  state.media = {
+    ownerId: "other",
+    status: "READY",
+    objectKey: "secret",
+    post: null,
+    owner: { image: null },
+  };
+  const args = { params: Promise.resolve({ id: "picture" }) },
+    req = new Request("https://dentora.test/api/media/picture");
+  expect((await GET(req, args)).status).toBe(404);
+  state.media.post = { deletedAt: new Date() };
+  expect((await GET(req, args)).status).toBe(404);
+  expect(downloadObject).not.toHaveBeenCalled();
+  state.media.post.deletedAt = null;
+  expect((await GET(req, args)).status).toBe(200);
+  state.viewer = undefined;
+  expect((await GET(req, args)).status).toBe(401);
+});
diff --git a/tests/social.integration.test.ts b/tests/social.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2979d4a537be753f79a4bb1c890ae9c85397e382
--- /dev/null
+++ b/tests/social.integration.test.ts
@@ -0,0 +1,158 @@
+import { beforeAll, afterAll, it, expect, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { PGlite } from "@electric-sql/pglite";
+import { PrismaPGlite } from "pglite-prisma-adapter";
+import { PrismaClient } from "@prisma/client";
+const state = vi.hoisted(() => ({ db: null as unknown as PrismaClient }));
+vi.mock("@/server/db", () => ({
+  get db() {
+    return state.db;
+  },
+}));
+vi.mock("@/server/auth", () => ({ auth: async () => null }));
+import { appRouter } from "../src/server/routers";
+let pg: PGlite, a: string, b: string;
+function caller(id: string) {
+  return appRouter.createCaller({
+    db: state.db,
+    session: { user: { id }, expires: "2099-01-01" },
+  });
+}
+beforeAll(async () => {
+  pg = new PGlite();
+  await pg.exec(
+    readFileSync(
+      "prisma/migrations/202610280001_initial/migration.sql",
+      "utf8",
+    ),
+  );
+  state.db = new PrismaClient({ adapter: new PrismaPGlite(pg) });
+  a = (
+    await state.db.user.create({
+      data: {
+        name: "Anna",
+        email: "anna@social.test",
+        username: "anna",
+        image: "/api/media/avatar-a",
+      },
+    })
+  ).id;
+  b = (
+    await state.db.user.create({
+      data: { name: "Ben", email: "ben@social.test", username: "ben" },
+    })
+  ).id;
+});
+afterAll(async () => {
+  await state.db.$disconnect();
+  await pg.close();
+});
+it("persists following across profile reads and supports unfollowing, without self-follow", async () => {
+  const api = caller(a);
+  await api.social.follow({ userId: b, follow: true });
+  await api.social.follow({ userId: b, follow: true });
+  const profile = await api.profile.public({ username: "ben" });
+  expect(profile?.following).toBe(true);
+  expect(profile?._count.follow_following).toBe(1);
+  expect(
+    (await api.profile.connections({ userId: b, kind: "followers" })).items[0]
+      .id,
+  ).toBe(a);
+  await expect(
+    api.social.follow({ userId: a, follow: true }),
+  ).rejects.toMatchObject({ code: "BAD_REQUEST" });
+  await api.social.follow({ userId: b, follow: false });
+  expect((await api.profile.public({ username: "ben" }))?.following).toBe(
+    false,
+  );
+});
+it("creates, likes, saves, comments and deletes with current counts and author photos", async () => {
+  const owner = caller(a),
+    viewer = caller(b),
+    post = await owner.social.create({ body: "Hallo Community" });
+  await viewer.social.like({ postId: post.id, liked: true });
+  await viewer.social.like({ postId: post.id, liked: true });
+  await viewer.social.save({ postId: post.id, saved: true });
+  const comment = await viewer.social.comment({
+    postId: post.id,
+    body: "Danke!",
+  });
+  const feed = await viewer.social.feed({ filter: "saved" });
+  expect(feed.items[0].author.image).toBe("/api/media/avatar-a");
+  expect(feed.items[0]._count).toEqual({ likes: 1, comments: 1 });
+  expect(
+    (await viewer.social.comments({ postId: post.id })).items[0].body,
+  ).toBe("Danke!");
+  await state.db.comment.update({
+    where: { id: comment.id },
+    data: { deletedAt: new Date() },
+  });
+  expect((await viewer.social.feed({})).items[0]._count.comments).toBe(0);
+  await expect(viewer.social.remove({ id: post.id })).rejects.toMatchObject({
+    code: "NOT_FOUND",
+  });
+  await owner.social.remove({ id: post.id });
+  expect((await viewer.social.feed({ filter: "saved" })).items).toHaveLength(0);
+  await expect(
+    viewer.social.save({ postId: post.id, saved: true }),
+  ).rejects.toMatchObject({ code: "NOT_FOUND" });
+  await expect(
+    viewer.social.comments({ postId: post.id }),
+  ).rejects.toMatchObject({ code: "NOT_FOUND" });
+  expect((await owner.profile.me()).user._count.post_author).toBe(0);
+});
+it("attaches only an owned unattached image, atomically, and allows image-only posts", async () => {
+  const image = await state.db.media.create({
+    data: {
+      ownerId: a,
+      objectKey: "a/photo.webp",
+      mimeType: "image/webp",
+      size: 100,
+      status: "READY",
+    },
+  });
+  const before = await state.db.post.count();
+  await expect(
+    caller(b).social.create({ body: "", mediaId: image.id }),
+  ).rejects.toMatchObject({ code: "BAD_REQUEST" });
+  expect(await state.db.post.count()).toBe(before);
+  const post = await caller(a).social.create({ body: "", mediaId: image.id });
+  expect(
+    (await caller(b).social.feed({})).items.find((p) => p.id === post.id)
+      ?.media_post[0].id,
+  ).toBe(image.id);
+  await expect(
+    caller(a).social.create({ body: "again", mediaId: image.id }),
+  ).rejects.toMatchObject({ code: "BAD_REQUEST" });
+  await expect(caller(a).social.create({ body: "   " })).rejects.toMatchObject({
+    code: "BAD_REQUEST",
+  });
+});
+it("paginates feeds without duplicates and respects private profiles and id fallback", async () => {
+  await state.db.post.createMany({
+    data: Array.from({ length: 25 }, (_, i) => ({
+      authorId: b,
+      body: `Topic ${i}`,
+    })),
+  });
+  const one = await caller(a).social.feed({ search: "Topic" }),
+    two = await caller(a).social.feed({
+      search: "Topic",
+      cursor: one.nextCursor,
+    });
+  expect(one.items).toHaveLength(20);
+  expect(two.items).toHaveLength(5);
+  expect(new Set([...one.items, ...two.items].map((p) => p.id)).size).toBe(25);
+  await state.db.user.update({
+    where: { id: b },
+    data: { publicProfile: false },
+  });
+  expect(await caller(a).profile.public({ username: "ben" })).toBeNull();
+  await expect(caller(a).social.feed({ authorId: b })).rejects.toMatchObject({
+    code: "NOT_FOUND",
+  });
+  expect((await caller(b).profile.public({ username: "~" + b }))?.isSelf).toBe(
+    true,
+  );
+  expect((await caller(a).profile.public({ username: "~" + a }))?.id).toBe(a);
+});
