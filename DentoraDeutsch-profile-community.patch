+"use client";
+import { useState } from "react";
+import { Award } from "lucide-react";
+import styles from "./profile.module.css";
+type Badge = {
+  id: string;
+  title: string;
+  description: string;
+  category: string;
+};
+const labels: Record<string, string> = {
+  xp: "Punkte",
+  streak: "Lernserie",
+  social: "Community",
+  lessons: "Lektionen",
+  learning: "Lernen",
+  specialty: "Fachgebiete",
+  likes: "Likes",
+};
+export function BadgeGallery({ badges }: { badges: Badge[] }) {
+  const [category, setCategory] = useState("all");
+  const categories = [...new Set(badges.map((b) => b.category))];
+  const visible =
+    category === "all" ? badges : badges.filter((b) => b.category === category);
+  return (
+    <section>
+      <div className={styles.badgeHeading}>
+        <h2>Erreichte Abzeichen</h2>
+        <span>{badges.length}</span>
+      </div>
+      <p className={styles.subtitle}>Meilensteine auf dem Lernweg.</p>
+      <div className={styles.badgeTabs}>
+        <button
+          aria-pressed={category === "all"}
+          onClick={() => setCategory("all")}
+        >
+          Alle
+        </button>
+        {categories.map((c) => (
+          <button
+            key={c}
+            aria-pressed={category === c}
+            onClick={() => setCategory(c)}
+          >
+            {labels[c.toLowerCase()] || c}
+          </button>
+        ))}
+      </div>
+      <div className={styles.badges}>
+        {visible.length ? (
+          visible.map((b) => (
+            <article key={b.id}>
+              <Award size={32} />
+              <h3>{b.title}</h3>
+              <p>{b.description}</p>
+            </article>
+          ))
+        ) : (
+          <p>
+            Noch keine Abzeichen. Jede abgeschlossene Lektion bringt dich
+            weiter.
+          </p>
+        )}
+      </div>
+    </section>
+  );
+}
diff --git a/src/features/profile/connections.tsx b/src/features/profile/connections.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c58e9c8a0af9b999d464a9a00afe945eb99fb969
--- /dev/null
+++ b/src/features/profile/connections.tsx
@@ -0,0 +1,61 @@
+"use client";
+import Link from "next/link";
+import { useInfiniteQuery } from "@tanstack/react-query";
+import { useTRPC } from "@/trpc/provider";
+import { Avatar } from "@/components/ui/avatar";
+import { Loading, ErrorNotice } from "@/components/ui/feedback";
+import { profileHref } from "@/features/community/profile-link";
+import styles from "./profile.module.css";
+export function Connections({
+  userId,
+  kind,
+  onClose,
+}: {
+  userId: string;
+  kind: "followers" | "following";
+  onClose: () => void;
+}) {
+  const api = useTRPC(),
+    data = useInfiniteQuery(
+      api.profile.connections.infiniteQueryOptions(
+        { userId, kind },
+        { getNextPageParam: (page) => page.nextCursor },
+      ),
+    );
+  return (
+    <section className={styles.connections}>
+      <header>
+        <h2>{kind === "followers" ? "Follower" : "Folgt"}</h2>
+        <button onClick={onClose}>Schließen</button>
+      </header>
+      {data.isPending ? (
+        <Loading />
+      ) : data.error ? (
+        <ErrorNotice message={data.error.message} />
+      ) : (
+        <>
+          {!data.data.pages[0].items.length && <p>Noch keine Einträge.</p>}
+          {data.data.pages
+            .flatMap((page) => page.items)
+            .map((user) => (
+              <Link key={user.id} href={profileHref(user)}>
+                <Avatar image={user.image} name={user.name} size={38} />
+                <span>
+                  {user.name || "Dentora Mitglied"}
+                  {user.username && <small>@{user.username}</small>}
+                </span>
+              </Link>
+            ))}
+          {data.hasNextPage && (
+            <button
+              disabled={data.isFetchingNextPage}
+              onClick={() => data.fetchNextPage()}
+            >
+              Weitere anzeigen
+            </button>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
