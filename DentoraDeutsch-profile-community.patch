diff --git a/src/server/media/image.ts b/src/server/media/image.ts
new file mode 100644
index 0000000000000000000000000000000000000000..afe7d127a0ed45fc16acd0a4310f583b9a368dce
--- /dev/null
+++ b/src/server/media/image.ts
@@ -0,0 +1,29 @@
+import sharp from "sharp";
+export const MAX_UPLOAD_BYTES = 2 * 1024 * 1024;
+export async function prepareImage(input: Buffer, purpose: "avatar" | "post") {
+  if (!input.length || input.length > MAX_UPLOAD_BYTES)
+    throw new Error("Bitte wähle ein Bild mit maximal 2 MB.");
+  const image = sharp(input, {
+    limitInputPixels: 16_000_000,
+    animated: false,
+    failOn: "error",
+  });
+  const meta = await image.metadata();
+  if (
+    !["jpeg", "png", "webp"].includes(meta.format ?? "") ||
+    (meta.pages ?? 1) > 1
+  )
+    throw new Error("Erlaubt sind JPG, PNG und WebP ohne Animation.");
+  const size = purpose === "avatar" ? 384 : 1440;
+  const result = await image
+    .rotate()
+    .resize(size, size, {
+      fit: purpose === "avatar" ? "cover" : "inside",
+      withoutEnlargement: true,
+    })
+    .webp({ quality: 80 })
+    .toBuffer();
+  if (result.length > MAX_UPLOAD_BYTES)
+    throw new Error("Das Bild ist zu groß. Bitte wähle ein kleineres Bild.");
+  return result;
+}
diff --git a/src/server/media/storage.ts b/src/server/media/storage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..860885e1fa4600ba01a1c0100d3ef26642ff0619
--- /dev/null
+++ b/src/server/media/storage.ts
@@ -0,0 +1,58 @@
+import "server-only";
+function settings() {
+  const raw = process.env.SUPABASE_URL,
+    key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  if (!raw || !key)
+    throw new Error(
+      "Der Bildupload ist noch nicht eingerichtet. Bitte kontaktiere den Support.",
+    );
+  const url = new URL(raw);
+  if (url.protocol !== "https:" || url.username || url.password)
+    throw new Error("Ungültige Storage-Konfiguration.");
+  const bucket = process.env.SUPABASE_MEDIA_BUCKET || "dentora-media";
+  if (!/^[a-z0-9-]+$/.test(bucket))
+    throw new Error("Ungültige Storage-Konfiguration.");
+  return {
+    base: `${url.origin}/storage/v1`,
+    bucket,
+    headers: { apikey: key, Authorization: `Bearer ${key}` },
+  };
+}
+export async function uploadObject(key: string, bytes: Buffer) {
+  const s = settings();
+  const response = await fetch(`${s.base}/object/${s.bucket}/${key}`, {
+    method: "POST",
+    headers: {
+      ...s.headers,
+      "Content-Type": "image/webp",
+      "x-upsert": "false",
+    },
+    body: new Uint8Array(bytes),
+    signal: AbortSignal.timeout(20000),
+  });
+  if (!response.ok)
+    throw new Error(
+      "Das Bild konnte nicht gespeichert werden. Bitte prüfe den Storage-Bucket und versuche es erneut.",
+    );
+}
+export async function downloadObject(key: string) {
+  const s = settings();
+  return fetch(
+    `${s.base}/object/authenticated/${s.bucket}/${key.split("/").map(encodeURIComponent).join("/")}`,
+    {
+      headers: s.headers,
+      cache: "no-store",
+      signal: AbortSignal.timeout(15000),
+    },
+  );
+}
+export async function deleteObject(key: string) {
+  const s = settings();
+  const response = await fetch(`${s.base}/object/${s.bucket}`, {
+    method: "DELETE",
+    headers: { ...s.headers, "Content-Type": "application/json" },
+    body: JSON.stringify({ prefixes: [key] }),
+    signal: AbortSignal.timeout(10000),
+  });
+  if (!response.ok) throw new Error("Storage cleanup failed");
+}
