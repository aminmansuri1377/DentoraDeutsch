diff --git a/src/features/learning/components/letter-answer.tsx b/src/features/learning/components/letter-answer.tsx
new file mode 100644
index 0000000..620b11a
--- /dev/null
+++ b/src/features/learning/components/letter-answer.tsx
@@ -0,0 +1,70 @@
+"use client";
+import { useState } from "react";
+import { Button } from "@/components/ui/button";
+export function LetterAnswer({
+  letters,
+  disabled,
+  savedText,
+  onChange,
+}: {
+  letters: string[];
+  disabled: boolean;
+  savedText?: string | null;
+  onChange: (value: string) => void;
+}) {
+  const [chosen, setChosen] = useState<number[]>([]);
+  function update(next: number[]) {
+    setChosen(next);
+    onChange(next.map((i) => letters[i]).join(""));
+  }
+  return (
+    <div className="letter-question">
+      <p className="muted">
+        Tippe die Buchstaben in der richtigen Reihenfolge an.
+      </p>
+      <div
+        className="letter-slots"
+        aria-label="Deine Antwort"
+        aria-live="polite"
+      >
+        {savedText ? (
+          <strong>{savedText}</strong>
+        ) : chosen.length ? (
+          chosen.map((index, position) => (
+            <button
+              type="button"
+              disabled={disabled}
+              key={index}
+              aria-label={`${letters[index]} entfernen, Stelle ${position + 1}`}
+              onClick={() => update(chosen.filter((_, i) => i !== position))}
+            >
+              {letters[index]}
+            </button>
+          ))
+        ) : (
+          <span>Dein Wort …</span>
+        )}
+      </div>
+      <div className="letter-bank">
+        {letters.map((letter, index) => (
+          <button
+            type="button"
+            key={index}
+            disabled={disabled || chosen.includes(index)}
+            aria-label={`Buchstabe ${letter}, ${index + 1}`}
+            onClick={() => update([...chosen, index])}
+          >
+            {letter}
+          </button>
+        ))}
+      </div>
+      <Button
+        variant="ghost"
+        disabled={disabled || !chosen.length}
+        onClick={() => update([])}
+      >
+        Zurücksetzen
+      </Button>
+    </div>
+  );
+}
diff --git a/src/features/learning/components/study-card.tsx b/src/features/learning/components/study-card.tsx
new file mode 100644
index 0000000..6fa40e8
--- /dev/null
+++ b/src/features/learning/components/study-card.tsx
@@ -0,0 +1,47 @@
+import { z } from "zod";
+const schema = z.object({
+  title: z.string(),
+  paragraphs: z.array(z.string()),
+  caption: z.string().optional(),
+  diagram: z.array(z.string()).optional(),
+});
+export function StudyCard({
+  text,
+  kind,
+  mediaUrl,
+}: {
+  text: string;
+  kind?: string;
+  mediaUrl?: string | null;
+}) {
+  if (kind !== "STUDY_CARD") return <p className="lesson-text">{text}</p>;
+  let parsed;
+  try {
+    parsed = schema.safeParse(JSON.parse(text));
+  } catch {
+    return <p className="lesson-text">{text}</p>;
+  }
+  if (!parsed.success) return <p className="lesson-text">{text}</p>;
+  const card = parsed.data;
+  return (
+    <article className="study-card">
+      <h2>{card.title}</h2>
+      {card.paragraphs.map((paragraph, i) => (
+        <p className="lesson-text" key={i}>
+          {paragraph}
+        </p>
+      ))}
+      {mediaUrl && /^\/(?!\/)/.test(mediaUrl) && (
+        <img src={mediaUrl} alt={card.title} className="study-image" />
+      )}
+      {card.diagram && !mediaUrl && (
+        <ol className="study-diagram" aria-label="Schematische Darstellung">
+          {card.diagram.map((label, i) => (
+            <li key={i}>{label}</li>
+          ))}
+        </ol>
+      )}
+      {card.caption && <p className="muted small">{card.caption}</p>}
+    </article>
+  );
+}
