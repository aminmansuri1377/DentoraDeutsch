{
  "name": "dentora",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs --auto-local",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate && node scripts/generate-panel.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/check-db.ts",
    "format": "prettier --write src prisma docs",
    "dev:local": "node scripts/dev.mjs --local"
  },
  "dependencies": {
    "@auth/prisma-adapter": "latest",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.90.0",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.4",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "latest",
    "superjson": "^2.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@prisma/internals": "^7.10.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "jsdom": "^30.1.3",
    "pglite-prisma-adapter": "^0.7.2",
    "prettier": "^3.6.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "nodemailer": "10.1.4"
  }
}
